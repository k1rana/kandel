node_modules/

# Rust build outputs
/target/
**/*.rs.bk

# Build artifacts
/build/
*.exe

# WinGet manifests generated from a released installer by
# scripts/release/winget-manifest.mjs. Submitted to microsoft/winget-pkgs, not
# authored here.
/winget/

# Design-review captures (regenerated locally; not part of the source)
.impeccable/review/

# Local authoring notes from the design/authoring skills. DESIGN.md is the
# durable design system and *is* committed.
doc/

# User-specific configuration
config.toml
*config.toml

# Local environment: holds the Tauri release signing key during a local build.
# The key must never be committed; CI reads it from repository secrets.
.env
.env.*
!.env.example

# Frontend
crates/kandel-ui/frontend/dist/
crates/kandel-ui/frontend/node_modules/

# Sidecar staging: the core binary is copied here (with a target-triple suffix)
# by scripts/stage-core.mjs for Tauri's externalBin. Build output.
crates/kandel-ui/binaries/

# Tauri-generated schemas
crates/kandel-ui/gen/

# Local scratch (harness configs, build/dev logs, toolchain setup)
.probe-*
*.log
rustup-*.log

# Dev scratch config created by `pnpm dev` (scripts/dev.mjs)
.dev/

# IDE and OS temporary files
.DS_Store
.idea/
.vscode/
