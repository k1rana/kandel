    "reducedMotion": "collapsed"
  },
  "signature": "a lime state charge per ledger row, tracking health down the page",
  "fonts": [
    { "name": "Sono", "license": "SIL OFL 1.1", "source": "Etcetera Type Co.", "path": "crates/kandel-ui/frontend/src/assets/fonts/" }
