{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kandel",
  "identifier": "dev.tojoo.kandel",
  "build": {
    "frontendDist": "frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir crates/kandel-ui/frontend dev",
    "beforeBuildCommand": "node scripts/stage-core.mjs && pnpm --dir crates/kandel-ui/frontend build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kandel",
        "width": 900,
        "height": 640,
        "minWidth": 520,
        "minHeight": 360,
        "resizable": true,
        "dragDropEnabled": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Farhan Brillan Widyakirana (k1rana)",
    "homepage": "https://github.com/k1rana/kandel",
    "shortDescription": "Per-process supervision for the Windows interactive session.",
    "longDescription": "Kandel launches, monitors, and auto-restarts the applications you tell it to keep alive, in the interactive desktop session that Windows services cannot reach.",
    "licenseFile": "../../LICENSE",
    "externalBin": ["binaries/kandel"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "installMode": "currentUser"
      }
    }
  }
}
