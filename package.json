{
  "name": "kandel",
  "description": "Per-process supervision for the Windows interactive session. Built with Rust and Tauri.",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:arm64": "node scripts/build.mjs --target aarch64-pc-windows-msvc",
    "package": "node scripts/package.mjs",
    "package:arm64": "node scripts/package.mjs --target aarch64-pc-windows-msvc",
    "release": "pnpm run build && pnpm run package",
    "winget": "node scripts/release/winget-manifest.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "cargo test --workspace && pnpm run test:ui",
    "test:ui": "pnpm --dir crates/kandel-ui/frontend test",
    "check": "cargo clippy --workspace --all-targets && pnpm run check:ui",
    "check:ui": "pnpm --dir crates/kandel-ui/frontend check",
    "precommit": "sh .husky/pre-commit",
    "prepare": "husky",
    "icons": "python scripts/make_icons.py",
    "clean": "shx rm -rf build target"
  },
  "devDependencies": {
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tauri-apps/cli": "^2",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "shx": "^0.4.0"
  },
  "packageManager": "pnpm@10.30.3"
}
